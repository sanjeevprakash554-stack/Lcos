# =====================================================================
# Logistics Operations Control System (LCOS) - Environment Configuration
# =====================================================================

# 1. Server Configuration
PORT=3000
NODE_ENV=production
# URL assigned by Render (e.g. https://lcos.onrender.com)
RENDER_EXTERNAL_URL=https://lcos.onrender.com
# Additional allowed CORS origins (comma-separated, optional)
ALLOWED_ORIGINS=https://lcos.onrender.com

# 2. Security & Authentication
# Strong, unique random string for signing JWT tokens. On Render, generate a 64-char random hex string.
JWT_SECRET=generate-a-strong-random-hex-string-for-production

# 3. Database Persistence (Hosted PostgreSQL vs Built-in Embedded SQLite)
# For Render PostgreSQL, Supabase, Neon, or Railway (Auto-initializes tables & seeds on first connect):
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=
# Set to 'true' only if you want to use the built-in zero-config embedded SQLite database
USE_EMBEDDED_DB=false
# Optional custom SQLite file path (e.g. '/data/lcos.sqlite' for Render Persistent Disks)
LCOS_DB_PATH=

# Local PostgreSQL connection fallbacks (used only when DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# 4. Indian Payment Gateway (Razorpay)
# Get your API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=

# 5. WhatsApp Cloud API (Meta for Developers)
# Get your credentials from https://developers.facebook.com/apps/
WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Verification token you choose when setting up the webhook in Meta Developers
WHATSAPP_VERIFY_TOKEN=lcos_meta_verify_token_2026
# Meta App Secret for validating webhook HMAC SHA-256 signatures (optional but recommended)
WHATSAPP_APP_SECRET=
# Phone number to receive escalation alerts or sandbox forwardings (format: 91XXXXXXXXXX)
HIGHER_OFFICIAL_PHONE=

# 6. Cold-Start & Free-Tier Optimization
# Set to 'true' if you want the server to self-ping /health every 13 minutes to stay warm
ENABLE_KEEP_ALIVE=false

# 7. GPS Telemetry & Retention Configuration
GPS_RETENTION_DAYS=90
GPS_MIN_ACCURACY_M=100
GPS_RATE_LIMIT_MS=3000
